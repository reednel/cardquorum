{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "paths": {
      "@cardquorum/shared": ["../../libs/shared/src/index.ts"],
      "@cardquorum/engine": ["../../libs/engine/src/index.ts"],
      "@cardquorum/sheepshead": ["../../libs/games/sheepshead/src/index.ts"],
      "@cardquorum/sheepshead/reporting": ["../../libs/games/sheepshead/src/reporting/index.ts"]
    },
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "target": "es2022",
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": false,
    "module": "preserve",
    "types": []
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true,
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "jest.config.ts",
    "jest.config.cts",
    "src/test-setup.ts"
  ],
  "references": [
    { "path": "../../libs/shared/tsconfig.lib.json" },
    { "path": "../../libs/engine/tsconfig.lib.json" },
    { "path": "../../libs/games/sheepshead/tsconfig.lib.json" }
  ]
}
